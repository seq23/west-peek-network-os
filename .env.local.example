# Decrypt secrets/network-os.local.env.gpg to create .env.local.
# This file is a safe example only. Do not store real secrets here.

APP_SESSION_SECRET=change-me-local-only
ADMIN_EMAIL_ALLOWLIST=sequoia@westpeek.ventures,scooter@westpeek.ventures

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://network.joinwestpeek.com/auth/callback/google
GOOGLE_SHEET_ID=replace-with-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account-email
GOOGLE_PRIVATE_KEY="replace-with-google-private-key"
GOOGLE_PRIVATE_KEY_ID=replace-with-google-private-key-id

GMAIL_TRIGGER_PHRASE=#wpnetwork
ACCEPTED_TRIGGER_ALIASES=#addtowestpeek,#westpeeknetwork

TOKEN_ENCRYPTION_SECRET=replace-with-token-encryption-secret
ANTHROPIC_API_KEY=replace-with-anthropic-key
AI_PROVIDER=anthropic

APP_BASE_URL=http://localhost:5173
CLOUDFLARE_PROJECT_NAME=west-peek-network-os
