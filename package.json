{
  "name": "west-peek-network-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "West Peek Network OS \u2014 private internal relationship intelligence app for adding people to the West Peek Network.",
  "scripts": {
    "build": "tsc -b && vite build",
    "cf:secrets:audit": "node scripts/cloudflare-secret-audit.mjs",
    "cf:secrets:sync": "node scripts/cloudflare-secret-sync.mjs",
    "cloudflare:secrets:audit": "node scripts/cloudflare-secret-audit.mjs",
    "cloudflare:secrets:sync": "node scripts/cloudflare-secret-sync.mjs",
    "dev": "vite",
    "env:remove": "node scripts/env-remove.mjs",
    "env:restore": "node scripts/env-restore.mjs",
    "env:trace": "node scripts/env-parity-trace.mjs",
    "postdeploy:smoke": "node scripts/postdeploy-smoke.mjs",
    "preview": "vite preview",
    "sheets:maintain": "node scripts/sheets/maintain-google-sheet.mjs",
    "test:domain": "node tests/domain/workflows.mjs",
    "test:e2e": "playwright test",
    "test:e2e:coverage-required": "playwright test tests/e2e/master-gauntlet.spec.ts tests/e2e/provider-failure-auth-mobile-edge.spec.ts tests/e2e/public-event-and-pitchlab.spec.ts --trace on --workers=1",
    "test:e2e:live": "playwright test tests/e2e/network-os.live.spec.ts --trace on --workers=1",
    "test:e2e:live-gmail": "playwright test tests/e2e/live-gmail-trigger-ingestion.spec.ts --trace on --workers=1",
    "test:e2e:local-headed": "PLAYWRIGHT_HEADED=1 playwright test tests/e2e/master-gauntlet.spec.ts tests/e2e/network-os.spec.ts --headed --trace on --workers=1",
    "test:e2e:master-gauntlet": "playwright test tests/e2e/master-gauntlet.spec.ts --trace on --workers=1",
    "test:e2e:maxdepth": "playwright test tests/e2e/network-os.spec.ts --trace on --workers=1",
    "test:event-database-intake": "node tests/domain/event-database-intake.mjs",
    "test:everything": "npm run validate:predeploy:full",
    "test:pitchlab-handoff": "node tests/domain/pitch-lab-handoff.mjs",
    "test:pitchlab-profile-lead": "node tests/domain/pitch-lab-profile-lead.mjs",
    "typecheck": "tsc --noEmit",
    "validate:9c": "npm run test:pitchlab-handoff",
    "validate:all": "npm run validate:structure && npm run validate:provider-lanes && npm run validate:secrets && npm run validate:google-private-key-contract && npm run validate:no-raw-atob-errors && npm run validate:oauth-connect-contract && npm run validate:provider-error-contract && npm run validate:tier4-live-proof-contract && npm run validate:tier4-lane-registry && npm run validate:tier4-report-schema && npm run validate:docs-match-package-scripts && npm run validate:repo-matrix-consistency && npm run validate:tier-docs-current && npm run validate:tier4-docs-complete && npm run test:domain && npm run test:pitchlab-handoff && npm run test:pitchlab-profile-lead && npm run test:event-database-intake && npm run build && npm run validate:playwright:maxdepth",
    "validate:docs-consolidation": "node scripts/validate-docs-consolidation.mjs",
    "validate:e2e-coverage": "node scripts/validate-e2e-coverage-matrix.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "validate:everything": "node scripts/validate-everything.mjs --tier=1",
    "validate:hostile-master-addendum": "node scripts/validate-hostile-master-addendum-crosscheck.mjs",
    "validate:playwright:maxdepth": "node scripts/validate-playwright-max-depth.mjs",
    "validate:release": "npm run validate:all && npm run build",
    "validate:secrets": "node scripts/check-no-plaintext-secrets.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "validate:triggers": "node scripts/validate-trigger-product-promises.mjs",
    "validate:validator-admission": "node scripts/validate-validator-admission.mjs",
    "test:e2e:live-gmail:real": "LIVE_GMAIL_TRIGGER_E2E=1 playwright test tests/e2e/live-gmail-trigger-ingestion.spec.ts --trace on --workers=1",
    "test:e2e:public-pitchlab-real": "playwright test tests/e2e/public-event-and-pitchlab.spec.ts --trace on --workers=1",
    "test:e2e:local-functions-headed": "PLAYWRIGHT_HEADED=1 playwright test tests/e2e/provider-failure-auth-mobile-edge.spec.ts tests/e2e/public-event-and-pitchlab.spec.ts --headed --trace on --workers=1",
    "test:e2e:maxdepth-headed": "PLAYWRIGHT_HEADED=1 playwright test tests/e2e/master-gauntlet.spec.ts tests/e2e/network-os.spec.ts tests/e2e/provider-failure-auth-mobile-edge.spec.ts --headed --trace on --workers=1",
    "validate:provider-lanes": "node scripts/validate-provider-lanes.mjs",
    "validate:final-tier-contract": "node scripts/validate-final-tier-contract.mjs",
    "validate:final-tier": "node scripts/run-test-everything-aggregate.mjs --tier=3",
    "test:everything:tier1": "node scripts/run-test-everything-aggregate.mjs --tier=1",
    "test:everything:tier2": "node scripts/run-test-everything-aggregate.mjs --tier=2",
    "test:everything:tier3": "node scripts/run-test-everything-aggregate.mjs --tier=3",
    "test:everything:unmatrixed": "node scripts/run-test-everything-aggregate.mjs --tier=2 --include-unmatrixed",
    "env:run": "node scripts/run-with-temp-env.mjs",
    "test:everything:with-env": "node scripts/run-with-temp-env.mjs -- npm run test:everything",
    "test:everything:tier1:with-env": "node scripts/run-with-temp-env.mjs -- npm run test:everything:tier1",
    "test:everything:tier2:with-env": "node scripts/run-with-temp-env.mjs -- npm run test:everything:tier2",
    "test:everything:tier3:with-env": "node scripts/run-with-temp-env.mjs -- npm run test:everything:tier3",
    "validate:final-tier:with-env": "node scripts/run-with-temp-env.mjs -- npm run validate:final-tier",
    "test:e2e:google-private-key-contract": "playwright test tests/e2e/google-private-key-contract.spec.ts --trace on --workers=1",
    "test:e2e:tier4-ultimate-live": "TIER4_ULTIMATE_LIVE_PROOF=1 playwright test tests/e2e/tier4-ultimate-live-proof.spec.ts --trace on --workers=1",
    "tier4:ultimate-live-proof": "node scripts/tier4_ultimate_live_proof.mjs",
    "validate:google-private-key-contract": "node scripts/validate-google-private-key-contract.mjs",
    "validate:oauth-connect-contract": "node scripts/validate-oauth-connect-contract.mjs",
    "validate:tier4-live-proof-contract": "node scripts/validate-tier4-live-proof-contract.mjs",
    "validate:provider-error-contract": "node scripts/validate-provider-error-contract.mjs",
    "validate:no-raw-atob-errors": "node scripts/validate-no-raw-atob-errors.mjs",
    "validate:no-generated-artifacts": "node scripts/validate-no-generated-artifacts.mjs",
    "validate:artifact-manifest-current": "node scripts/validate-artifact-manifest-current.mjs",
    "validate:tier4-lane-registry": "node scripts/validate-tier4-lane-registry.mjs",
    "validate:tier4-report-schema": "node scripts/validate-tier4-report-schema.mjs",
    "validate:docs-match-package-scripts": "node scripts/validate-docs-match-package-scripts.mjs",
    "validate:repo-matrix-consistency": "node scripts/validate-repo-matrix-consistency.mjs",
    "validate:no-localhost-defaults": "node scripts/validate-no-localhost-defaults.mjs",
    "validate:tier-docs-current": "node scripts/validate-tier-docs-current.mjs",
    "validate:tier4-docs-complete": "node scripts/validate-tier4-docs-complete.mjs",
    "validate:predeploy:full": "node scripts/validate-predeploy-full.mjs",
    "validate:postdeploy:strict": "node scripts/postdeploy-strict.mjs",
    "release:proof": "node scripts/release-proof.mjs",
    "tier4:dry-run-blocked": "node scripts/tier4_dry_run_blocked.mjs",
    "postdeploy:click-audit": "node scripts/postdeploy-click-audit.mjs",
    "postdeploy:auth-boundary": "node scripts/postdeploy-auth-boundary.mjs",
    "postdeploy:provider-health": "node scripts/postdeploy-provider-health.mjs",
    "postdeploy:public-event-smoke": "node scripts/postdeploy-public-event-smoke.mjs",
    "postdeploy:pitchlab-smoke": "node scripts/postdeploy-pitchlab-smoke.mjs",
    "postdeploy:oauth-route-safe-response": "node scripts/postdeploy-oauth-route-safe-response.mjs",
    "postdeploy:no-localhost-links": "node scripts/postdeploy-no-localhost-links.mjs",
    "postdeploy:no-raw-crash-pages": "node scripts/postdeploy-no-raw-crash-pages.mjs",
    "tier4:prereq-postdeploy-strict": "npm run validate:postdeploy:strict",
    "tier4:oauth-connect-live": "npm run test:e2e:tier4-ultimate-live",
    "tier4:gmail-trigger-ingestion-live": "npm run test:e2e:live-gmail:real",
    "tier4:google-sheets-readwrite-live": "node scripts/tier4_google_sheets_readwrite_live.mjs",
    "tier4:human-review-workflow-live": "node scripts/tier4_human_review_workflow_live.mjs",
    "tier4:contact-workflow-live": "node scripts/tier4_contact_workflow_live.mjs",
    "tier4:relationship-touch-live": "node scripts/tier4_relationship_touch_live.mjs",
    "tier4:public-event-live": "node scripts/tier4_public_event_live.mjs",
    "tier4:pitchlab-signed-handoff-live": "npm run test:e2e:public-pitchlab-real",
    "tier4:ai-ocr-voice-live": "node scripts/tier4_ai_ocr_voice_live.mjs",
    "tier4:auth-boundary-live": "node scripts/tier4_auth_boundary_live.mjs",
    "tier4:runtime-context-live": "node scripts/tier4_runtime_context_live.mjs",
    "tier4:report-check": "node scripts/tier4_report_check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "heic2any": "^0.0.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "^25.9.3",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
