{
  "name": "west-peek-network-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "West Peek Network OS — private internal relationship intelligence app for adding people to the West Peek Network.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:structure": "node scripts/validate-structure.mjs",
    "validate:secrets": "node scripts/check-no-plaintext-secrets.mjs",
    "validate:all": "npm run validate:structure && npm run validate:secrets && npm run test:domain && npm run test:pitchlab-handoff && npm run validate:playwright:maxdepth",
    "test:e2e": "playwright test",
    "test:domain": "node tests/domain/workflows.mjs",
    "sheets:maintain": "node scripts/sheets/maintain-google-sheet.mjs",
    "test:e2e:maxdepth": "playwright test tests/e2e/network-os.spec.ts --trace on --workers=1",
    "test:e2e:live": "playwright test tests/e2e/network-os.live.spec.ts --trace on --workers=1",
    "validate:playwright:maxdepth": "node scripts/validate-playwright-max-depth.mjs",
    "test:pitchlab-handoff": "node tests/domain/pitch-lab-handoff.mjs",
    "validate:9c": "npm run test:pitchlab-handoff"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "heic2any": "^0.0.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
