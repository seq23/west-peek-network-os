{
  "repo": "west-peek-network-os",
  "cloudflareTarget": "pages",
  "cloudflareProjectName": "west-peek-network-os",
  "encryptedVault": "secrets/west-peek-network-os.env.local.gpg",
  "legacyEncryptedVault": "secrets/network-os.local.env.gpg",
  "requiredRuntimeEnv": [
    "APP_SESSION_SECRET",
    "ADMIN_EMAIL_ALLOWLIST",
    "GOOGLE_CLIENT_ID",
